# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# MongoDB (leave empty in development to auto-start an in-memory MongoDB)
MONGODB_URI=
# MONGODB_URI=mongodb://localhost:27017/elite-paradize

# Secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES=7d
TABLE_TOKEN_SECRET=change-me-table-token-secret

# CORS (comma-separated allowed origins, or * )
CORS_ORIGIN=http://localhost:3000

# Uploads
UPLOAD_DIR=public/uploads

# Rate limits
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
LOGIN_RATE_MAX=10
ORDER_RATE_MAX=5
ORDER_RATE_WINDOW_MIN=10
REQUEST_RATE_MAX=3
REQUEST_RATE_WINDOW_MIN=5

# Kitchen timers (minutes)
LATE_ORDER_MINUTES=20
WARN_ORDER_MINUTES=10

# Session auto-close (hours of inactivity)
AUTO_CLOSE_SESSION_HOURS=3
